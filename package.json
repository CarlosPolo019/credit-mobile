{
  "name": "creditmobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prestart": "node scripts/write-mobile-config.js",
    "android": "react-native run-android",
    "preandroid": "node scripts/write-mobile-config.js && node scripts/ensure-android-debug-keystore.js",
    "android:device": "CREDIT_API_BASE_URL=https://fyatest-api.cmescorcia.com npm run android",
    "start": "react-native start",
    "start:device": "CREDIT_API_BASE_URL=https://fyatest-api.cmescorcia.com npm start",
    "pretest": "node scripts/write-mobile-config.js",
    "test": "jest",
    "prelint": "node scripts/write-mobile-config.js",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "pretypecheck": "node scripts/write-mobile-config.js",
    "typecheck": "tsc --noEmit",
    "prebuild:apk": "node scripts/write-mobile-config.js && node scripts/ensure-android-debug-keystore.js",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "prebuild:aab": "node scripts/write-mobile-config.js && node scripts/ensure-android-debug-keystore.js",
    "build:aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "axios": "^1.13.2",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.25.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "^0.83.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
